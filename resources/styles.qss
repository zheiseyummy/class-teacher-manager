QMainWindow {
    background: #f4f6fa;
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 13px;
    color: #1f2937;
}

#sidebar {
    background: #1d67d4;
    border: none;
    border-right: 1px solid #155bbd;
}

#brandMark {
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
}

#brandTitle {
    color: #ffffff;
    font-size: 17px;
    font-weight: 700;
}

#brandSubtitle {
    color: #cfe1ff;
    font-size: 11px;
}

#sidebarFooter {
    background: rgba(10, 55, 132, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 7px;
}

#sidebarVersion {
    color: #dbe9ff;
    font-size: 11px;
    font-weight: 600;
}

#sidebarPersonalMark {
    color: #b8d2f7;
    font-size: 10px;
}

#sidebarPersonalMark[clickable="true"]:hover {
    color: #ffffff;
}

#menu {
    background: transparent;
    color: #e4efff;
    outline: none;
    border: none;
    padding: 4px 0;
}

#menu::item {
    min-height: 44px;
    padding: 0 11px;
    margin: 2px 0;
    border: 1px solid transparent;
    border-radius: 7px;
}

#menu::item:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
}

#menu::item:selected {
    background: #ffffff;
    color: #225fca;
    border-color: #ffffff;
    font-weight: 600;
}

#content {
    background: #f4f6fa;
}

#shellHeader {
    min-height: 62px;
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #e4e9f1;
}

#pageTitle {
    color: #172033;
    font-size: 22px;
    font-weight: 700;
}

#pageTitle[clickable="true"]:hover {
    color: #1d5fd0;
}

#profileDialogIcon {
    background: #eaf2ff;
    border: 1px solid #cfe0ff;
    border-radius: 8px;
}

#dialogTitle {
    color: #172033;
    font-size: 18px;
    font-weight: 700;
}

#dialogHint, #privacyHint {
    color: #7a8799;
    font-size: 11px;
}

#sectionTitle {
    color: #28364a;
    font-size: 13px;
    font-weight: 700;
}

#profileClassList {
    color: #344054;
    background: #f9fafc;
    border: 1px solid #dfe5ed;
    border-radius: 7px;
    padding: 4px;
}

#profileClassList::item {
    min-height: 28px;
    padding: 0 6px;
}

#profilePreview {
    color: #315175;
    background: #f1f6fd;
    border: 1px solid #d8e6f7;
    border-radius: 7px;
    padding: 9px 11px;
    font-size: 11px;
}

#pageSubtitle {
    color: #7a8799;
    font-size: 12px;
}

#headerDate {
    color: #536176;
    background: #f7f9fc;
    border: 1px solid #e3e8f0;
    border-radius: 7px;
    padding: 8px 12px;
}

#pageArea {
    background: #f4f6fa;
}

#topBar {
    background: #ffffff;
    border: 1px solid #e2e7ef;
    border-radius: 8px;
}

#page {
    background: #ffffff;
    border: 1px solid #e2e7ef;
    border-radius: 8px;
}

QLineEdit, QComboBox, QDateEdit, QTimeEdit, QPlainTextEdit, QTextEdit {
    min-height: 35px;
    color: #243247;
    background: #ffffff;
    border: 1px solid #d8e0ea;
    border-radius: 7px;
    padding: 0 10px;
    selection-background-color: #dbeafe;
}

QPlainTextEdit, QTextEdit {
    padding: 8px 10px;
}

QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QTimeEdit:hover, QPlainTextEdit:hover, QTextEdit:hover {
    border-color: #b9c8dc;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #3b82f6;
    background: #ffffff;
}

QComboBox::drop-down, QDateEdit::drop-down, QTimeEdit::drop-down {
    width: 28px;
    border: none;
}

QPushButton {
    min-height: 35px;
    padding: 0 13px;
    color: #3c4b61;
    background: #ffffff;
    border: 1px solid #d8e0ea;
    border-radius: 7px;
    icon-size: 16px 16px;
}

QPushButton:hover {
    color: #1d5fd1;
    background: #f4f8ff;
    border-color: #b9cdf1;
}

QPushButton:pressed {
    background: #e8f0ff;
    border-color: #94b5ec;
}

QPushButton:disabled {
    color: #a5adba;
    background: #f6f7f9;
    border-color: #e7eaf0;
}

QPushButton#primaryButton {
    color: #ffffff;
    background: #2563eb;
    border-color: #2563eb;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    color: #ffffff;
    background: #1d55d3;
    border-color: #1d55d3;
}

QPushButton#primaryButton:pressed {
    background: #1949b8;
    border-color: #1949b8;
}

QPushButton#iconButton {
    min-width: 36px;
    max-width: 36px;
    padding: 0;
}

#summaryText {
    color: #667085;
    font-size: 13px;
}

#tablePane, #detailPane, #qualityPane, #scorePane, #plannerToolbar, #calendarPane, #calendarEventsPane {
    background: #ffffff;
    border: 1px solid #e1e7ef;
    border-radius: 8px;
}

QTableView, QTableWidget {
    color: #334155;
    background: #ffffff;
    border: 1px solid #e1e7ef;
    border-radius: 8px;
    gridline-color: #edf0f4;
    selection-background-color: #e8f1ff;
    selection-color: #1f3f72;
    alternate-background-color: #fafcfd;
}

#studentTable {
    border: none;
}

QTableView::item, QTableWidget::item {
    padding: 0 8px;
    border: none;
    border-bottom: 1px solid #f0f2f5;
}

QTableView::item:hover, QTableWidget::item:hover {
    background: #f6f9fe;
}

QTableView::item:selected, QTableWidget::item:selected {
    background: #e5efff;
    color: #1c3f72;
}

QHeaderView::section {
    min-height: 36px;
    color: #667085;
    background: #f8fafc;
    border: none;
    border-bottom: 1px solid #e5e9ef;
    border-right: 1px solid #eef1f4;
    padding: 0 8px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background: #f1f6fd;
    color: #1f5fc8;
}

#detailName {
    color: #172234;
    font-size: 20px;
    font-weight: 700;
}

#mutedLabel, #detailValue {
    color: #667085;
}

#sectionTitle {
    color: #243042;
    font-size: 15px;
    font-weight: 650;
}

#qualityScore {
    color: #147b5c;
    font-size: 14px;
    font-weight: 600;
}

#finalReviewState {
    color: #344054;
    font-size: 13px;
    font-weight: 600;
}

#finalReviewSummary {
    color: #475467;
    background: #f7f9fb;
    border: 1px solid #e2e7ee;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 13px;
}

#finalReviewTable QComboBox {
    min-height: 28px;
    margin: 3px 6px;
    padding-left: 10px;
}

#placeholder {
    color: #98a2b3;
    font-size: 16px;
}

QTabWidget::pane {
    top: -1px;
    background: #ffffff;
    border: 1px solid #e2e7ee;
    border-radius: 8px;
}

QTabBar::tab {
    min-height: 32px;
    color: #667085;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0 13px;
    margin-right: 4px;
}

QTabBar::tab:hover {
    color: #1f5fc8;
    background: #f2f6fd;
    border-radius: 6px;
}

QTabBar::tab:selected {
    color: #1f5fc8;
    border-bottom-color: #2563eb;
    font-weight: 600;
}

#workbenchHeaderControls {
    background: transparent;
    border: none;
}

#workbenchDateDisplay {
    min-height: 35px;
    max-height: 35px;
    background: #ffffff;
    border: 1px solid #d8e0ea;
    border-radius: 7px;
}

#workbenchDateLabel {
    color: #405067;
    font-size: 12px;
}

#metricCard {
    background: #ffffff;
    border: 1px solid #e1e7ef;
    border-radius: 8px;
}

#metricCard:hover {
    border-color: #c9d7eb;
}

#metricIcon {
    border: 1px solid transparent;
    border-radius: 8px;
}

QLabel#metricIcon[tone="blue"] {
    background: #e7efff;
    border-color: #cfddfa;
}

QLabel#metricIcon[tone="green"] {
    background: #e4f5ef;
    border-color: #cbe9df;
}

QLabel#metricIcon[tone="purple"] {
    background: #efe9fb;
    border-color: #ded1f4;
}

QLabel#metricIcon[tone="orange"] {
    background: #fff2df;
    border-color: #f3dfbd;
}

QLabel#metricIcon[tone="red"] {
    background: #fdebec;
    border-color: #f5d2d6;
}

#dashboardMetricLabel {
    color: #667489;
    font-size: 11px;
}

#dashboardMetricValue {
    color: #172033;
    font-size: 21px;
    font-weight: 700;
}

#dashboardMetricNote {
    color: #8793a4;
    font-size: 10px;
}

#dashboardPanel {
    background: #ffffff;
    border: 1px solid #e1e7ef;
    border-radius: 8px;
}

#dashboardPanelTitle {
    color: #1f2b3d;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#dashboardActionButton {
    min-height: 28px;
    padding: 0 9px;
    color: #46607e;
    background: #ffffff;
    border-color: #dce4ef;
    font-size: 11px;
    icon-size: 14px 14px;
}

QPushButton#dashboardActionButton:hover {
    color: #1f5fc8;
    background: #f4f8ff;
    border-color: #bfd0ec;
}

#scoreFluctuationSummary {
    color: #16865f;
    background: #e8f6f0;
    border: 1px solid #d1ebdf;
    border-radius: 5px;
    padding: 4px 7px;
    font-size: 10px;
    font-weight: 600;
}

QListWidget#dashboardList {
    color: #334155;
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#dashboardList::item {
    background: transparent;
    border: none;
    border-bottom: 1px solid #edf1f5;
}

QListWidget#dashboardList::item:last {
    border-bottom: none;
}

#dashboardRow {
    background: transparent;
    border: none;
}

#rowPrimary {
    color: #253247;
    font-size: 12px;
    font-weight: 600;
}

#scoreStudentName, #scoreCompare {
    color: #253247;
    font-size: 11px;
    font-weight: 600;
}

#subjectChange {
    color: #7c899b;
    font-size: 9px;
}

QLabel#rankChangeBadge {
    color: #657287;
    background: #f1f4f8;
    border: 1px solid #e4e9ef;
    border-radius: 5px;
    padding: 2px 5px;
    font-size: 9px;
    font-weight: 600;
}

QLabel#rankChangeBadge[tone="up"] {
    color: #16865f;
    background: #e6f5ef;
    border-color: #cfe9df;
}

QLabel#rankChangeBadge[tone="down"] {
    color: #c84753;
    background: #fde9eb;
    border-color: #f4cfd4;
}

QLabel#rankChangeBadge[tone="steady"] {
    color: #657287;
    background: #f1f4f8;
    border-color: #e4e9ef;
}

#rowSecondary, #rowMeta {
    color: #7c899b;
    font-size: 10px;
}

#rowMetaStrong {
    color: #405067;
    font-size: 11px;
    font-weight: 600;
}

#eventTime {
    font-size: 11px;
}

#subjectMark {
    font-size: 12px;
}

QLabel#statusBadge {
    color: #657287;
    background: #f1f4f8;
    border: 1px solid #e4e9ef;
    border-radius: 5px;
    padding: 4px 7px;
    font-size: 10px;
    font-weight: 600;
}

QLabel#statusBadge[tone="info"] {
    color: #2863ba;
    background: #eaf2ff;
    border-color: #d5e4fb;
}

QLabel#statusBadge[tone="success"] {
    color: #16865f;
    background: #e6f5ef;
    border-color: #cfe9df;
}

QLabel#activityKind {
    color: #657287;
    background: #f1f4f8;
    border: 1px solid #e3e8ef;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#activityKind[tone="success"] {
    color: #16865f;
    background: #e6f5ef;
    border-color: #cfe9df;
}

QLabel#activityKind[tone="warning"] {
    color: #bd7411;
    background: #fff1dc;
    border-color: #f3dfbd;
}

QLabel#activityKind[tone="danger"] {
    color: #c84753;
    background: #fde9eb;
    border-color: #f4cfd4;
}

QLabel#activityKind[tone="info"] {
    color: #6443ad;
    background: #efe9fb;
    border-color: #ddd1f3;
}

#dashboardEmptyState {
    color: #98a3b2;
    font-size: 11px;
}

#plannerToolbar {
    min-height: 40px;
}

#backupPanel {
    background: #ffffff;
    border: 1px solid #e4e8ee;
    border-radius: 8px;
}

#backupPanelTitle {
    color: #253042;
    font-size: 15px;
    font-weight: 700;
}

#backupHint {
    color: #6f7d8e;
    font-size: 12px;
    line-height: 1.45;
}

#backupDivider {
    color: #e7ebf0;
    background: #e7ebf0;
    max-height: 1px;
    border: none;
}

#classColorSwatch {
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
}

#courseTable {
    border-radius: 8px;
}

#courseTable::item {
    padding: 5px 8px;
}

#calendarPane {
    min-width: 310px;
}

#calendarEventsPane {
    border: none;
    background: transparent;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: #f8fafc;
    border-bottom: 1px solid #e9edf2;
}

QCalendarWidget QToolButton {
    min-width: 30px;
    min-height: 30px;
    color: #344054;
    background: transparent;
    border: none;
    border-radius: 5px;
}

QCalendarWidget QToolButton:hover {
    color: #1f5fc8;
    background: #edf4ff;
}

QCalendarWidget QMenu {
    color: #344054;
}

QCalendarWidget QAbstractItemView {
    color: #344054;
    background: #ffffff;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: none;
}

QCheckBox {
    color: #4f5d6e;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #c8d0da;
    border-radius: 4px;
    background: #ffffff;
}

QCheckBox::indicator:checked {
    background: #2563eb;
    border-color: #2563eb;
}

QDialog {
    color: #243042;
    background: #ffffff;
}

QDialogButtonBox {
    padding-top: 4px;
}

QMenu {
    color: #344054;
    background: #ffffff;
    border: 1px solid #dfe5ec;
    border-radius: 7px;
    padding: 5px;
}

QMenu::item {
    min-height: 30px;
    padding: 0 24px 0 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    color: #1f5fc8;
    background: #edf4ff;
}

QToolTip {
    color: #ffffff;
    background: #253042;
    border: none;
    border-radius: 4px;
    padding: 5px 7px;
}

QScrollBar:vertical {
    width: 10px;
    background: transparent;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background: #cfd7e1;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #aebbc8;
}

QScrollBar:horizontal {
    height: 10px;
    background: transparent;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    min-width: 28px;
    background: #cfd7e1;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #aebbc8;
}

QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
    border: none;
}

QSplitter::handle {
    background: #f4f6fa;
}

QSplitter::handle:hover {
    background: #d7e4f8;
}

QSplitter::handle:horizontal {
    width: 8px;
}

QSplitter::handle:vertical {
    height: 8px;
}

#mainSplitter::handle {
    background: #dfe6f1;
}

#mainSplitter::handle:hover {
    background: #91afe4;
}

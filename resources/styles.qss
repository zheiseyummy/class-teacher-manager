QMainWindow {
    background: #f5f7fa;
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 13px;
    color: #253247;
}

#sidebar {
    background: #f9fbfd;
    border: none;
    border-right: 1px solid #dde4ec;
}

#brandMark {
    background: #eaf1ff;
    border: 1px solid #d3e1fb;
    border-radius: 8px;
}

#brandTitle {
    color: #172235;
    font-size: 16px;
    font-weight: 700;
}

#brandSubtitle {
    color: #758397;
    font-size: 11px;
}

#sidebarFooter {
    background: #f2f5f9;
    border: 1px solid #e1e7ee;
    border-radius: 7px;
}

#sidebarVersion {
    color: #53657a;
    font-size: 11px;
    font-weight: 600;
}

#sidebarPersonalMark {
    color: #7b899b;
    font-size: 10px;
}

#sidebarPersonalMark[clickable="true"]:hover {
    color: #2f64d6;
}

#menu {
    background: transparent;
    color: #45556b;
    outline: none;
    border: none;
    padding: 4px 0;
}

#menu::item {
    min-height: 42px;
    padding: 0 11px;
    margin: 2px 0;
    border: 1px solid transparent;
    border-radius: 7px;
}

#menu::item:hover {
    background: #eef3f9;
    color: #234f9f;
}

#menu::item:selected {
    background: #e9f1ff;
    color: #2459bd;
    border-color: #d4e2fb;
    font-weight: 600;
}

#content {
    background: #f5f7fa;
}

#shellHeader {
    min-height: 60px;
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #e4e9f1;
}

#pageTitle {
    color: #172235;
    font-size: 22px;
    font-weight: 700;
}

#pageTitle[clickable="true"]:hover {
    color: #2f64d6;
}

#profileDialogIcon {
    background: #eaf2ff;
    border: 1px solid #cfe0ff;
    border-radius: 8px;
}

#dialogTitle {
    color: #172033;
    font-size: 18px;
    font-weight: 700;
}

#dialogHint, #privacyHint {
    color: #7a8799;
    font-size: 11px;
}

#sectionTitle {
    color: #28364a;
    font-size: 13px;
    font-weight: 700;
}

#profileClassList {
    color: #344054;
    background: #f9fafc;
    border: 1px solid #dfe5ed;
    border-radius: 7px;
    padding: 4px;
}

#profileClassList::item {
    min-height: 28px;
    padding: 0 6px;
}

#profilePreview {
    color: #315175;
    background: #f1f6fd;
    border: 1px solid #d8e6f7;
    border-radius: 7px;
    padding: 9px 11px;
    font-size: 11px;
}

#pageSubtitle {
    color: #728095;
    font-size: 12px;
}

#headerDate {
    color: #526176;
    background: #f8fafc;
    border: 1px solid #dfe5ec;
    border-radius: 7px;
    padding: 8px 12px;
}

#pageArea {
    background: #f5f7fa;
}

#topBar, #moduleToolbar, #filterBar, #plannerToolbar {
    background: #ffffff;
    border: 1px solid #dde4ec;
    border-radius: 8px;
}

#toolbarContext {
    color: #344257;
    font-size: 13px;
    font-weight: 650;
}

#page {
    background: #ffffff;
    border: 1px solid #e2e7ef;
    border-radius: 8px;
}

QLineEdit, QComboBox, QDateEdit, QTimeEdit, QPlainTextEdit, QTextEdit {
    min-height: 38px;
    color: #243247;
    background: #ffffff;
    border: 1px solid #cfd8e3;
    border-radius: 7px;
    padding: 0 10px;
    selection-background-color: #dbeafe;
}

QPlainTextEdit, QTextEdit {
    padding: 8px 10px;
}

QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QTimeEdit:hover, QPlainTextEdit:hover, QTextEdit:hover {
    border-color: #9fb1c6;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #2f64d6;
    background: #ffffff;
}

QComboBox::drop-down, QDateEdit::drop-down, QTimeEdit::drop-down {
    width: 28px;
    border: none;
}

QPushButton {
    min-height: 38px;
    padding: 0 13px;
    color: #3b4a5f;
    background: #ffffff;
    border: 1px solid #cfd8e3;
    border-radius: 7px;
    icon-size: 16px 16px;
}

QPushButton:hover {
    color: #2459bd;
    background: #f2f6fd;
    border-color: #9fb7de;
}

QPushButton:pressed {
    background: #e7eefb;
    border-color: #809fce;
}

QPushButton:disabled {
    color: #a5adba;
    background: #f6f7f9;
    border-color: #e7eaf0;
}

QPushButton#primaryButton {
    color: #ffffff;
    background: #2f64d6;
    border-color: #2f64d6;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    color: #ffffff;
    background: #2859c3;
    border-color: #2859c3;
}

QPushButton#primaryButton:pressed {
    background: #234da8;
    border-color: #234da8;
}

QPushButton#primaryButton:disabled {
    color: #a5adba;
    background: #e9edf3;
    border-color: #e1e6ed;
}

QPushButton#dangerButton {
    color: #b53d49;
    background: #ffffff;
    border-color: #e7c7cc;
}

QPushButton#dangerButton:hover {
    color: #a3323e;
    background: #fff4f5;
    border-color: #dca9b1;
}

QPushButton#dangerButton:disabled {
    color: #a5adba;
    background: #f6f7f9;
    border-color: #e7eaf0;
}

QPushButton:focus, QToolButton:focus {
    border: 1px solid #2f64d6;
}

QToolButton#compactNavButton, QToolButton#moreButton {
    min-height: 38px;
    color: #405068;
    background: #ffffff;
    border: 1px solid #cfd8e3;
    border-radius: 7px;
    padding: 0 10px;
    icon-size: 17px 17px;
}

QToolButton#compactNavButton {
    min-width: 38px;
    max-width: 38px;
    padding: 0;
}

QToolButton#moreButton:hover, QToolButton#compactNavButton:hover {
    color: #2459bd;
    background: #f2f6fd;
    border-color: #9fb7de;
}

QToolButton#moreButton::menu-indicator {
    image: none;
}

QPushButton#iconButton {
    min-width: 36px;
    max-width: 36px;
    padding: 0;
}

#summaryText {
    color: #667085;
    font-size: 13px;
}

#tablePane, #detailPane, #qualityPane, #scorePane, #plannerToolbar, #calendarPane, #calendarEventsPane {
    background: #ffffff;
    border: 1px solid #dde4ec;
    border-radius: 8px;
}

QTableView, QTableWidget {
    color: #334155;
    background: #ffffff;
    border: 1px solid #dde4ec;
    border-radius: 8px;
    gridline-color: #edf0f4;
    selection-background-color: #e7effd;
    selection-color: #1f3f72;
    alternate-background-color: #fafbfd;
}

#studentTable {
    border: none;
}

QTableView::item, QTableWidget::item {
    padding: 0 8px;
    border: none;
    border-bottom: 1px solid #f0f2f5;
}

QTableView::item:hover, QTableWidget::item:hover {
    background: #f1f5fb;
}

QTableView::item:selected, QTableWidget::item:selected {
    background: #e5eefc;
    color: #1f4584;
}

QHeaderView::section {
    min-height: 38px;
    color: #5c697c;
    background: #f6f8fb;
    border: none;
    border-bottom: 1px solid #e5e9ef;
    border-right: 1px solid #eef1f4;
    padding: 0 8px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background: #f1f6fd;
    color: #1f5fc8;
}

#detailName {
    color: #172234;
    font-size: 18px;
    font-weight: 700;
}

#mutedLabel, #detailValue {
    color: #667085;
}

#sectionTitle {
    color: #243042;
    font-size: 15px;
    font-weight: 650;
}

#qualityScore {
    color: #147b5c;
    font-size: 14px;
    font-weight: 600;
}

#finalReviewState {
    color: #344054;
    font-size: 13px;
    font-weight: 600;
}

#finalReviewSummary {
    color: #475467;
    background: #f7f9fb;
    border: 1px solid #e2e7ee;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 13px;
}

#finalReviewTable QComboBox {
    min-height: 28px;
    margin: 3px 6px;
    padding-left: 10px;
}

#placeholder {
    color: #98a2b3;
    font-size: 16px;
}

#dataStateStack {
    background: transparent;
    border: none;
}

#emptyState {
    background: #ffffff;
    border: none;
}

#emptyStateIcon {
    background: #f0f4f8;
    border: 1px solid #dfe6ee;
    border-radius: 8px;
}

#emptyStateTitle {
    color: #2b394d;
    font-size: 15px;
    font-weight: 650;
}

#emptyStateMessage {
    color: #748195;
    font-size: 12px;
}

QPushButton#emptyActionButton {
    margin-top: 4px;
    color: #2459bd;
    background: #eef4ff;
    border-color: #d1e0fb;
    font-weight: 600;
}

QPushButton#emptyActionButton:hover {
    background: #e3edff;
    border-color: #b8cef4;
}

QScrollArea#detailScroll,
QScrollArea#studentDetailScroll,
QScrollArea#attendanceDetailScroll,
QScrollArea#moralDetailScroll,
QScrollArea#qualityEditorScroll,
QScrollArea#scoreDetailScroll,
QScrollArea#backupSettingsScroll,
QScrollArea#workbenchScroll {
    background: transparent;
    border: none;
}

QScrollArea#studentDetailScroll > QWidget > QWidget,
QScrollArea#attendanceDetailScroll > QWidget > QWidget,
QScrollArea#moralDetailScroll > QWidget > QWidget,
QScrollArea#qualityEditorScroll > QWidget > QWidget,
QScrollArea#scoreDetailScroll > QWidget > QWidget,
QScrollArea#backupSettingsScroll > QWidget > QWidget,
QScrollArea#workbenchScroll > QWidget > QWidget {
    background: transparent;
}

QMainWindow[compact="true"] #shellHeader {
    min-height: 52px;
}

QMainWindow[compact="true"] #pageTitle {
    font-size: 18px;
}

QMainWindow[compact="true"] #topBar,
QMainWindow[compact="true"] #moduleToolbar,
QMainWindow[compact="true"] #filterBar,
QMainWindow[compact="true"] #plannerToolbar {
    border-radius: 7px;
}

QMainWindow[compact="true"] QPushButton,
QMainWindow[compact="true"] QToolButton#moreButton,
QMainWindow[compact="true"] QToolButton#compactNavButton {
    min-height: 40px;
}

QMainWindow[compact="true"] QLineEdit,
QMainWindow[compact="true"] QComboBox,
QMainWindow[compact="true"] QDateEdit,
QMainWindow[compact="true"] QTimeEdit {
    min-height: 40px;
}

QTabWidget::pane {
    top: -1px;
    background: #ffffff;
    border: 1px solid #e2e7ee;
    border-radius: 8px;
}

QTabBar::tab {
    min-height: 36px;
    color: #667085;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0 14px;
    margin-right: 4px;
}

QTabBar::tab:hover {
    color: #1f5fc8;
    background: #f2f6fd;
    border-radius: 6px;
}

QTabBar::tab:selected {
    color: #2459bd;
    border-bottom-color: #2f64d6;
    font-weight: 600;
}

#workbenchHeaderControls {
    background: transparent;
    border: none;
}

#workbenchDateDisplay {
    min-height: 35px;
    max-height: 35px;
    background: #ffffff;
    border: 1px solid #d8e0ea;
    border-radius: 7px;
}

#workbenchDateLabel {
    color: #405067;
    font-size: 12px;
}

#metricCard {
    background: #ffffff;
    border: 1px solid #dde4ec;
    border-radius: 8px;
}

#metricCard:hover {
    border-color: #c9d7eb;
}

#metricIcon {
    border: 1px solid transparent;
    border-radius: 8px;
}

QLabel#metricIcon[tone="blue"] {
    background: #e7efff;
    border-color: #cfddfa;
}

QLabel#metricIcon[tone="green"] {
    background: #e4f5ef;
    border-color: #cbe9df;
}

QLabel#metricIcon[tone="purple"] {
    background: #efe9fb;
    border-color: #ded1f4;
}

QLabel#metricIcon[tone="orange"] {
    background: #fff2df;
    border-color: #f3dfbd;
}

QLabel#metricIcon[tone="red"] {
    background: #fdebec;
    border-color: #f5d2d6;
}

#dashboardMetricLabel {
    color: #667489;
    font-size: 11px;
}

#dashboardMetricValue {
    color: #172033;
    font-size: 21px;
    font-weight: 700;
}

#dashboardMetricNote {
    color: #8793a4;
    font-size: 10px;
}

#dashboardPanel {
    background: #ffffff;
    border: 1px solid #dde4ec;
    border-radius: 8px;
}

#dashboardPanelTitle {
    color: #1f2b3d;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#dashboardActionButton {
    min-height: 28px;
    padding: 0 9px;
    color: #46607e;
    background: #ffffff;
    border-color: #dce4ef;
    font-size: 11px;
    icon-size: 14px 14px;
}

QPushButton#dashboardActionButton:hover {
    color: #1f5fc8;
    background: #f4f8ff;
    border-color: #bfd0ec;
}

#scoreFluctuationSummary {
    color: #16865f;
    background: #e8f6f0;
    border: 1px solid #d1ebdf;
    border-radius: 5px;
    padding: 4px 7px;
    font-size: 10px;
    font-weight: 600;
}

QListWidget#dashboardList {
    color: #334155;
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#dashboardList::item {
    background: transparent;
    border: none;
    border-bottom: 1px solid #edf1f5;
}

QListWidget#dashboardList::item:last {
    border-bottom: none;
}

#dashboardRow {
    background: transparent;
    border: none;
}

#rowPrimary {
    color: #253247;
    font-size: 12px;
    font-weight: 600;
}

#scoreStudentName, #scoreCompare {
    color: #253247;
    font-size: 11px;
    font-weight: 600;
}

#subjectChange {
    color: #7c899b;
    font-size: 9px;
}

QLabel#rankChangeBadge {
    color: #657287;
    background: #f1f4f8;
    border: 1px solid #e4e9ef;
    border-radius: 5px;
    padding: 2px 5px;
    font-size: 9px;
    font-weight: 600;
}

QLabel#rankChangeBadge[tone="up"] {
    color: #16865f;
    background: #e6f5ef;
    border-color: #cfe9df;
}

QLabel#rankChangeBadge[tone="down"] {
    color: #c84753;
    background: #fde9eb;
    border-color: #f4cfd4;
}

QLabel#rankChangeBadge[tone="steady"] {
    color: #657287;
    background: #f1f4f8;
    border-color: #e4e9ef;
}

#rowSecondary, #rowMeta {
    color: #7c899b;
    font-size: 10px;
}

#rowMetaStrong {
    color: #405067;
    font-size: 11px;
    font-weight: 600;
}

#eventTime {
    font-size: 11px;
}

#subjectMark {
    font-size: 12px;
}

QLabel#statusBadge {
    color: #657287;
    background: #f1f4f8;
    border: 1px solid #e4e9ef;
    border-radius: 5px;
    padding: 4px 7px;
    font-size: 10px;
    font-weight: 600;
}

QLabel#statusBadge[tone="info"] {
    color: #2459bd;
    background: #eaf2ff;
    border-color: #d5e4fb;
}

QLabel#statusBadge[tone="success"] {
    color: #16865f;
    background: #e6f5ef;
    border-color: #cfe9df;
}

QLabel#activityKind {
    color: #657287;
    background: #f1f4f8;
    border: 1px solid #e3e8ef;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#activityKind[tone="success"] {
    color: #16865f;
    background: #e6f5ef;
    border-color: #cfe9df;
}

QLabel#activityKind[tone="warning"] {
    color: #bd7411;
    background: #fff1dc;
    border-color: #f3dfbd;
}

QLabel#activityKind[tone="danger"] {
    color: #c84753;
    background: #fde9eb;
    border-color: #f4cfd4;
}

QLabel#activityKind[tone="info"] {
    color: #6443ad;
    background: #efe9fb;
    border-color: #ddd1f3;
}

#dashboardEmptyState {
    color: #98a3b2;
    font-size: 11px;
}

#plannerToolbar {
    min-height: 40px;
}

#backupPanel {
    background: #ffffff;
    border: 1px solid #dde4ec;
    border-radius: 8px;
}

#backupPanelTitle {
    color: #253042;
    font-size: 15px;
    font-weight: 700;
}

#backupHint {
    color: #6f7d8e;
    font-size: 12px;
    line-height: 1.45;
}

#backupDivider {
    color: #e7ebf0;
    background: #e7ebf0;
    max-height: 1px;
    border: none;
}

#classColorSwatch {
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
}

#courseTable {
    border-radius: 8px;
}

#courseTable::item {
    padding: 5px 8px;
}

#calendarPane {
    min-width: 310px;
}

#calendarEventsPane {
    border: none;
    background: transparent;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: #f8fafc;
    border-bottom: 1px solid #e9edf2;
}

QCalendarWidget QToolButton {
    min-width: 30px;
    min-height: 30px;
    color: #344054;
    background: transparent;
    border: none;
    border-radius: 5px;
}

QCalendarWidget QToolButton:hover {
    color: #1f5fc8;
    background: #edf4ff;
}

QCalendarWidget QMenu {
    color: #344054;
}

QCalendarWidget QAbstractItemView {
    color: #344054;
    background: #ffffff;
    selection-background-color: #2f64d6;
    selection-color: #ffffff;
    outline: none;
}

QCheckBox {
    color: #4f5d6e;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #c8d0da;
    border-radius: 4px;
    background: #ffffff;
}

QCheckBox::indicator:checked {
    background: #2f64d6;
    border-color: #2f64d6;
}

QDialog {
    color: #243042;
    background: #ffffff;
}

QWidget#dialogScrollContent {
    background: #ffffff;
}

QDialogButtonBox {
    padding-top: 4px;
}

QMenu {
    color: #344054;
    background: #ffffff;
    border: 1px solid #dfe5ec;
    border-radius: 7px;
    padding: 5px;
}

QMenu::item {
    min-height: 30px;
    padding: 0 24px 0 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    color: #1f5fc8;
    background: #edf4ff;
}

QToolTip {
    color: #ffffff;
    background: #253042;
    border: none;
    border-radius: 4px;
    padding: 5px 7px;
}

QScrollBar:vertical {
    width: 10px;
    background: transparent;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background: #cfd7e1;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #aebbc8;
}

QScrollBar:horizontal {
    height: 10px;
    background: transparent;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    min-width: 28px;
    background: #cfd7e1;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #aebbc8;
}

QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
    border: none;
}

QSplitter::handle {
    background: #f4f6fa;
}

QSplitter::handle:hover {
    background: #d7e4f8;
}

QSplitter::handle:horizontal {
    width: 8px;
}

QSplitter::handle:vertical {
    height: 8px;
}

#mainSplitter::handle {
    background: #dde4ec;
}

#mainSplitter::handle:hover {
    background: #9fb7de;
}
